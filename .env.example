# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. For local development run `npx supabase start` and use the values it prints
# (API URL and publishable key). The publishable key is safe in the browser; secret or
# service_role keys are server-only and must never be committed or pasted into chat.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gusty's reading (server-only). Without it the app uses a labelled demo mode.
# ANTHROPIC_API_KEY=
# GUSTY_AI_MODEL=claude-opus-5-5
